# coldmail hosted app. Copy to .env for local development; set these in your host's dashboard in production.

# Public URL of the app, no trailing slash. Local: http://localhost:3000
APP_URL=http://localhost:3000

# Long random string (at least 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Postgres connection string. Leave empty locally to use the built-in PGlite database in data/dev-db.
DATABASE_URL=

# Claude API key from console.anthropic.com (pay-per-use).
ANTHROPIC_API_KEY=

# Google OAuth client of type "Web application". Redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email lookup (optional; without them emails come from research + pattern guesses)
HUNTER_API_KEY=
APOLLO_API_KEY=

# Limits
MONTHLY_RUN_LIMIT=3        # searches per user per month
DAILY_SEND_LIMIT=50        # emails per user per day
MAX_CONCURRENT_RUNS=3      # searches running at once across everyone
ADMIN_EMAILS=              # comma-separated; these accounts have no monthly limit

# Shown on the privacy and terms pages
CONTACT_EMAIL=

PORT=3000
