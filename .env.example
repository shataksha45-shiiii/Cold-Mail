# Copy this file to .env and fill in what you have. Both are optional:
# without them the tool falls back to Claude's research + pattern guesses.

# Apollo: https://app.apollo.io -> Settings -> Integrations -> API
APOLLO_API_KEY=

# Hunter: https://hunter.io/api-keys
HUNTER_API_KEY=

# Port for the local review page
PORT=3000

# Optional: connect this laptop to your hosted coldmail site so searches you start there run here.
# Run with: npm run helper
COLDMAIL_URL=
COLDMAIL_WORKER_TOKEN=
